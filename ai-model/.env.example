# ==============================================================================
# DevPilot AI Python Subsystem - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the Python service:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
#
# NEVER COMMIT PRIVATE PASSWORDS OR KEYS TO GIT.
# ==============================================================================

# --- Service Host & Port ---
# Bind to 0.0.0.0 in Docker and Render cloud deployments; 127.0.0.1 for local testing.
AI_HOST=0.0.0.0
AI_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# --- Inference Provider & Ollama Configuration ---
# Local Development:
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Production Deployment:
#   Do NOT use http://127.0.0.1:11434 in a cloud deployment (e.g. Render).
#   Render containers cannot reach your local Windows laptop.
#   Configure a remote authenticated inference URL or hosted provider endpoint:
#   OLLAMA_BASE_URL=https://your-remote-gpu-server.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m

# --- Context & Generation Tuning (Optimized for 8 GB RAM / Low-Resource Inference) ---
MAX_CONTEXT_TOKENS=8192
MAX_OUTPUT_TOKENS=4096
DEFAULT_NUM_CTX=2048
MAX_CONCURRENT_INFERENCES=1
TEMPERATURE=0.2

# --- Task-Specific Max Output Token Budgets ---
CHAT_MAX_TOKENS=384
EXPLAIN_MAX_TOKENS=512
DEBUG_MAX_TOKENS=768
CODE_GEN_MAX_TOKENS=1536

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed origins
CORS_ORIGINS=https://devpilot-frontend.onrender.com,https://devpilot-backend.onrender.com,http://localhost:4200,http://localhost:5000
