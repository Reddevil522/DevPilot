# DevPilot AI Subsystem (.gitignore)

# Dedicated Python Virtual Environment
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
*.env.local

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
logs/
*.log

# Model weights & large binaries (never commit weights)
models/
*.weights
*.bin
*.onnx
*.gguf
*.safetensors

# Editor & OS temporary files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
