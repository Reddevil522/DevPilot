# ==============================================================================
# DevPilot Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env (Linux/macOS)
#   copy .env.example .env (Windows)
#
# NEVER COMMIT REAL PASSWORDS, CREDENTIALS, OR PRIVATE TOKENS TO GIT.
# ==============================================================================

# --- Node Environment & Server Port ---
NODE_ENV=production
PORT=5000

# --- MongoDB Database Connection ---
# Set to your MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/devpilot?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devpilot?retryWrites=true&w=majority

# --- Cross-Origin Resource Sharing (CORS) ---
# FRONTEND_URL: Primary deployed frontend URL (without trailing slash)
FRONTEND_URL=https://devpilot-frontend.onrender.com
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins (e.g. https://devpilot-frontend.onrender.com,http://localhost:4200)
CORS_ALLOWED_ORIGINS=https://devpilot-frontend.onrender.com,http://localhost:4200

# --- Cookie & Session Security ---
# In production across different domains, COOKIE_SAME_SITE must be 'none' and COOKIE_SECURE must be 'true'.
# In local development (localhost), 'lax' and 'false' can be used.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# --- JWT Authentication Secrets ---
# Generate cryptographically secure keys (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Python AI Subsystem Service ---
# URL of the DevPilot Python AI FastAPI service.
# For local development: http://127.0.0.1:8001
# For Render deployment: https://devpilot-ai.onrender.com (or internal Render service name)
PYTHON_AI_URL=https://devpilot-ai.onrender.com
AI_PROVIDER=python
AI_TIMEOUT_SECONDS=120

# --- Ollama / Model Configuration ---
# Name of the code model (must match the model available on the inference server)
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=120

# --- Local Workspace / Persistent Disk Storage ---
# Optional: Base directory for local workspace projects on a persistent disk (Linux)
# PROJECTS_STORAGE_DIR=/var/data/devpilot/projects

# --- Email Service (SMTP for Account Verification & Password Resets) ---
# Leave empty or configure with Ethereal (testing) or SendGrid / Resend / AWS SES
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password
